# Environment Variables Template
# Copy this file to .env and fill in your actual values

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/contention-portal

# JWT Secret Key (use a cryptographically random value of at least 32 bytes)
JWT_SECRET=replace-with-a-random-production-secret
# JWT_EXPIRES_IN=12h

# Server Port (optional, defaults to 8080)
PORT=8080

# Runtime mode and optional cross-origin frontend URL.
# Leave CORS_ORIGIN unset when the frontend is served by this application.
NODE_ENV=production
# CORS_ORIGIN=https://contention.example.com
